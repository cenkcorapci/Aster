    {
      "title": "Cluster replicas (StatefulSet scale)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sim_cluster_replicas",
          "legendFormat": "replicas"
        },
        {
          "expr": "count(up{job=\"aster\"} == 1)",
          "legendFormat": "aster pods up"
        }
      ]
    },
    {
      "title": "Ops rate (cluster)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(upserts_total[1m]))", "legendFormat": "upserts/s" },
        { "expr": "sum(rate(deletes_total[1m]))", "legendFormat": "deletes/s" },
        { "expr": "sum(rate(searches_total[1m]))", "legendFormat": "searches/s" },
        { "expr": "sum(rate(sim_controller_ops_total[1m]))", "legendFormat": "controller ops/s" }
      ]
    },
    {
      "title": "Write latency p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(write_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "write p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(write_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "write p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(read_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "search p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(read_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "search p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(delete_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "delete p95"
        }
      ]
    },
    {
