{
  "annotations": { "list": [] },
  "description": "M4-T07: Aster Prometheus metrics (write/read/HNSW latency, ops, segments). Works with sim-grafana provisioning or manual import against a Prometheus that scrapes Aster GET /metrics. Datasource UID must be `prometheus` (or remap on import).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Ops rate",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(upserts_total[1m]))", "legendFormat": "upserts/s", "refId": "A" },
        { "expr": "sum(rate(deletes_total[1m]))", "legendFormat": "deletes/s", "refId": "B" },
        { "expr": "sum(rate(searches_total[1m]))", "legendFormat": "searches/s", "refId": "C" },
        { "expr": "sum(rate(gets_total[1m]))", "legendFormat": "gets/s", "refId": "D" },
        { "expr": "sum(rate(sim_controller_ops_total[1m]))", "legendFormat": "controller ops/s", "refId": "E" }
      ]
    },
    {
      "title": "Write / delete / flush latency p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(write_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "write p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(write_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "write p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(delete_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "delete p95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(flush_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "flush p95",
          "refId": "D"
        }
      ]
    },
    {
      "title": "Search latency p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(read_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "read p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(read_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "read p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(hnsw_search_latency_bucket[1m])) by (le))",
          "legendFormat": "hnsw p50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hnsw_search_latency_bucket[1m])) by (le))",
          "legendFormat": "hnsw p95",
          "refId": "D"
        }
      ]
    },
    {
      "title": "Indexes & vectors (per scrape target)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "collection_count", "legendFormat": "collections {{pod}}", "refId": "A" },
        { "expr": "vectors_estimate", "legendFormat": "vectors {{pod}}", "refId": "B" },
        { "expr": "segment_count", "legendFormat": "segments {{pod}}", "refId": "C" },
        { "expr": "memtable_rows", "legendFormat": "memtable {{pod}}", "refId": "D" },
        { "expr": "compaction_backlog", "legendFormat": "compaction backlog {{pod}}", "refId": "E" }
      ]
    },
    {
      "title": "Drain / gossip / replication",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(drain_total[1m]))", "legendFormat": "drains/s", "refId": "A" },
        { "expr": "sum(rate(gossip_messages[1m]))", "legendFormat": "gossip/s", "refId": "B" },
        { "expr": "replication_lag", "legendFormat": "replication_lag {{pod}}", "refId": "C" }
      ]
    },
    {
      "title": "Cluster replicas (StatefulSet scale)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sim_cluster_replicas", "legendFormat": "replicas", "refId": "A" },
        { "expr": "count(up{job=\"aster\"} == 1)", "legendFormat": "aster targets up", "refId": "B" }
      ]
    },
    {
      "title": "CPU cores (cadvisor, per pod)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"aster-sim\",pod=~\"aster-node-.*\",container=\"aster\"}[1m])) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"aster-sim\",pod=~\"aster-node-.*\",container=\"aster\"}[1m]))",
          "legendFormat": "TOTAL aster",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Memory working set (bytes, per pod)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"aster-sim\",pod=~\"aster-node-.*\",container=\"aster\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"aster-sim\",pod=~\"aster-node-.*\",container=\"aster\"})",
          "legendFormat": "TOTAL aster",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Controller: scale events & index targets",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sim_scale_events_total", "legendFormat": "scale events", "refId": "A" },
        { "expr": "sim_indexes_configured", "legendFormat": "indexes", "refId": "B" },
        { "expr": "sim_target_total_rows", "legendFormat": "target rows", "refId": "C" },
        { "expr": "sim_actual_total_rows", "legendFormat": "actual row budget", "refId": "D" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["aster", "sim", "m4-t07"],
