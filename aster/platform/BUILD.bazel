load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# Always available (Arduino / MCU / hosted).
cc_library(
    name = "memory",
    srcs = ["memory_storage.cc"],
    hdrs = [
        "memory_storage.h",
        "storage_backend.h",
    ],
    deps = ["//aster/core"],
)

# POSIX filesystem backend — excluded for --config=arduino (baremetal).
cc_library(
    name = "posix",
    srcs = ["posix_storage.cc"],
    hdrs = ["posix_storage.h"],
    target_compatible_with = select({
        "//platforms:is_baremetal": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":memory",
        "//aster/core",
    ],
)

# S3-compatible object storage skeleton — HTTP Put/Get/List/Remove.
# Excluded for baremetal; multipart / Range GET / SigV4 deferred to M8-T01.
cc_library(
    name = "s3",
    srcs = ["s3_storage.cc"],
    hdrs = ["s3_storage.h"],
    target_compatible_with = select({
        "//platforms:is_baremetal": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":memory",
        "//aster/core",
    ],
)

# In-process FakeS3 for tests (also usable against LocalStack-style clients).
cc_library(
    name = "s3_fake",
    srcs = ["s3_fake.cc"],
    hdrs = ["s3_fake.h"],
    target_compatible_with = select({
        "//platforms:is_baremetal": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//aster/core"],
)

# Umbrella matching historical //aster/platform:platform.
cc_library(
    name = "platform",
    deps = [":memory"] + select({
        "//platforms:is_baremetal": [],
        "//conditions:default": [
            ":posix",
            ":s3",
        ],
    }),
)

cc_test(
    name = "platform_test",
    size = "small",
    srcs = ["platform_test.cc"],
    target_compatible_with = select({
        "//platforms:is_baremetal": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":platform",
        ":s3_fake",
        "@googletest//:gtest_main",
    ],
)
