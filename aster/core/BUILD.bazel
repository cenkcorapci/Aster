load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "core",
    srcs = [
        "cbor.cc",
        "hash.cc",
    ],
    hdrs = [
        "cbor.h",
        "features.h",
        "hash.h",
        "status.h",
        "types.h",
    ],
)

cc_test(
    name = "core_test",
    size = "small",
    srcs = ["core_test.cc"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "cbor_test",
    size = "small",
    srcs = ["cbor_test.cc"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "features_test",
    size = "small",
    srcs = ["features_test.cc"],
    deps = [
        ":core",
        "@googletest//:gtest_main",
    ],
)
