load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "distributed",
    srcs = [
        "gossip.cc",
        "rebalance.cc",
        "ring.cc",
    ],
    hdrs = [
        "gossip.h",
        "rebalance.h",
        "ring.h",
    ],
    deps = ["//aster/core"],
)

cc_test(
    name = "distributed_test",
    size = "small",
    srcs = [
        "gossip_test.cc",
        "rebalance_test.cc",
        "ring_test.cc",
    ],
    deps = [
        ":distributed",
        "@googletest//:gtest_main",
    ],
)
