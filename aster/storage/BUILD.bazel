load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "storage",
    srcs = [
        "memtable.cc",
        "segment.cc",
        "wal.cc",
    ],
    hdrs = [
        "memtable.h",
        "segment.h",
        "wal.h",
    ],
    deps = [
        "//aster/core",
        "//aster/index",
    ],
)

cc_test(
    name = "storage_test",
    size = "small",
    srcs = ["storage_test.cc"],
    deps = [
        ":storage",
        "@googletest//:gtest_main",
    ],
)
