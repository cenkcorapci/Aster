load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "index",
    srcs = [
        "bloom.cc",
        "distance.cc",
        "exact_index.cc",
        "hnsw_build.cc",
        "hnsw_graph.cc",
        "hnsw_pin.cc",
        "hnsw_search.cc",
        "tags.cc",
    ],
    hdrs = [
        "bloom.h",
        "distance.h",
        "hnsw_build.h",
        "hnsw_graph.h",
        "hnsw_pin.h",
        "hnsw_search.h",
        "tags.h",
        "vector_index.h",
    ],
    deps = ["//aster/core"],
)

cc_test(
    name = "index_test",
    size = "small",
    srcs = ["index_test.cc"],
    deps = [
        ":index",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "hnsw_pin_test",
    size = "small",
    srcs = ["hnsw_pin_test.cc"],
    target_compatible_with = select({
        "//platforms:is_baremetal": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":index",
        "//aster/platform:s3",
        "//aster/platform:s3_fake",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "distance_test",
    size = "small",
    srcs = ["distance_test.cc"],
    deps = [
        ":index",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "tags_test",
    size = "small",
    srcs = ["tags_test.cc"],
    deps = [
        ":index",
        "@googletest//:gtest_main",
    ],
)
