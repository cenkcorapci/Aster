load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "index",
    srcs = [
        "bloom.cc",
        "distance.cc",
        "exact_index.cc",
        "hnsw_graph.cc",
    ],
    hdrs = [
        "bloom.h",
        "distance.h",
        "hnsw_graph.h",
        "vector_index.h",
    ],
    deps = ["//aster/core"],
)

cc_test(
    name = "index_test",
    size = "small",
    srcs = ["index_test.cc"],
    deps = [
        ":index",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "distance_test",
    size = "small",
    srcs = ["distance_test.cc"],
    deps = [
        ":index",
        "@googletest//:gtest_main",
    ],
)
