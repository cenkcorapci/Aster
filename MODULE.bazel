"""Aster: a peer-to-peer, low-resource vector database.

Monorepo layout:
  //aster/...    C++ core engine (kernel, storage, index, distributed, query, rpc)
  //clients/...  Client libraries (C++, Python, Go, Rust, Java, Scala, JavaScript)
  //tla/...      TLA+ formal specifications
  //docs/...     Design and reference documentation
"""

module(
    name = "aster",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)
# YAML corpus parser for //clients/conformance (M5-T03).
bazel_dep(name = "yaml-cpp", version = "0.9.0", dev_dependency = True)

# Apache Thrift C++ runtime (minimal subset; see third_party/thrift.BUILD).
# Server C++ stubs remain checked in under aster/rpc/gen-cpp/ (scripts/regen-thrift-cpp.sh).
# Client-language stub *generation* (M5-T02) uses the host/CI thrift binary via
# @thrift_compiler — see tools/thrift/ and //clients:thrift_stubs.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
host_thrift_repository = use_repo_rule("//tools/thrift:host_thrift_repo.bzl", "host_thrift_repository")

host_thrift_repository(name = "thrift_compiler")

http_archive(
    name = "apache_thrift",
    build_file = "//third_party:thrift.BUILD",
    patch_cmds = [
        """cat > lib/cpp/src/thrift/config.h << 'EOF'
/* Minimal config.h for Aster's Bazel thrift runtime (POSIX hosts). */
#ifndef CONFIG_H
#define CONFIG_H
#define PACKAGE "thrift"
#define PACKAGE_NAME "thrift"
#define PACKAGE_TARNAME "thrift"
#define PACKAGE_VERSION "0.24.0"
#define PACKAGE_STRING "thrift 0.24.0"
#define PACKAGE_BUGREPORT ""
#define PACKAGE_URL ""
#define ARITHMETIC_RIGHT_SHIFT 1
#define SIGNED_RIGHT_SHIFT_IS 1
#define HAVE_INTTYPES_H 1
#define HAVE_NETINET_IN_H 1
#define HAVE_SYS_SOCKET_H 1
#define HAVE_SYS_UN_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_SYS_RESOURCE_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_IOCTL_H 1
#define HAVE_POLL_H 1
#define HAVE_NETDB_H 1
#define HAVE_UNISTD_H 1
#define HAVE_FCNTL_H 1
#define HAVE_STRERROR_R 1
#define HAVE_CLOCK_GETTIME 1
#define HAVE_CXX11 1
#endif /* CONFIG_H */
EOF
""",
        # Upstream TUuid.cpp pulls Boost.UUID; Aster IDL does not use UUID.
        # Provide a boost-free implementation so the C++ runtime stays lean.
        """cat > lib/cpp/src/thrift/TUuid.cpp << 'EOF'
#include <thrift/TUuid.h>
#include <cstdio>
#include <cstring>

namespace apache {
namespace thrift {

TUuid::TUuid(const std::string& /*str*/) noexcept {
  // Leave nil UUID; string parsing requires Boost in upstream.
}

bool TUuid::is_nil() const noexcept {
  for (size_t i = 0; i < size(); ++i) {
    if (data_[i] != 0) {
      return false;
    }
  }
  return true;
}

std::string to_string(const TUuid& uuid) noexcept(false) {
  char buf[37];
  const uint8_t* d = uuid.data();
  std::snprintf(
      buf,
      sizeof(buf),
      "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
      d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7],
      d[8], d[9], d[10], d[11], d[12], d[13], d[14], d[15]);
  return std::string(buf);
}

}  // namespace thrift
}  // namespace apache
EOF
""",
        # Upstream TSSLSocket.cpp uses boost::shared_array for OpenSSL mutexes.
        # We avoid pulling full Boost by providing a tiny compatible header
        # later in patch_cmds. Here we only ensure <unistd.h> is present
        # because TSSLSocket.cpp calls close().
        """python3 - <<'PY'
from pathlib import Path

p = Path('lib/cpp/src/thrift/transport/TSSLSocket.cpp')
s = p.read_text()

# If a previous patch_cmds run already replaced boost::shared_array with
# std::unique_ptr, restore the original boost-based logic.
if 'std::unique_ptr<Mutex[]>' in s or 'static std::unique_ptr<Mutex[]>' in s:
  s = s.replace('static std::unique_ptr<Mutex[]> mutexes;',
                'static boost::shared_array<Mutex> mutexes;')
  if '#include <boost/shared_array.hpp>' not in s:
    s = s.replace('#include <openssl/opensslv.h>',
                  '#include <boost/shared_array.hpp>\\n#include <openssl/opensslv.h>')

  s = s.replace('mutexes.reset(new Mutex[CRYPTO_num_locks()]);',
                'mutexes = boost::shared_array<Mutex>(new Mutex[CRYPTO_num_locks()]);')
  s = s.replace('mutexes.reset(new Mutex[ ::CRYPTO_num_locks()]);',
                'mutexes = boost::shared_array<Mutex>(new Mutex[ ::CRYPTO_num_locks()]);')

# Apache Thrift's TSSLSocket.cpp uses `close()` via THRIFT_CLOSESOCKET,
# but relies on <unistd.h> being included. Ensure it is present.
if '#include <unistd.h>' not in s:
  s = s.replace('#define OPENSSL_VERSION_NO_THREAD_ID_BEFORE',
                '#include <unistd.h>\\n\\n#define OPENSSL_VERSION_NO_THREAD_ID_BEFORE')

p.write_text(s)
PY
""",
        # Provide a tiny self-contained `boost/shared_array.hpp` so Thrift's
        # SSL runtime can compile without pulling full Boost.
        """mkdir -p lib/cpp/src/boost && cat > lib/cpp/src/boost/shared_array.hpp << 'EOF'
#pragma once

#include <cstddef>
#include <memory>

namespace boost {

template <class T>
class shared_array {
 public:
  shared_array() = default;
  explicit shared_array(T* p) : ptr_(p, std::default_delete<T[]>()) {}

  T& operator[](std::size_t i) const { return ptr_.get()[i]; }

  void reset() { ptr_.reset(); }

 private:
  std::shared_ptr<T> ptr_;
};

}  // namespace boost
EOF
""",
        # Apache Thrift's SSL transport includes <openssl/ssl.h>. In this
        # environment the OpenSSL headers are not on the default compiler
        # include search path, so copy them into the extracted thrift
        # repository and add `-Iopenssl/include` in //third_party:thrift.BUILD.
        """python3 - <<'PY'
from __future__ import annotations

import glob
import shutil
from pathlib import Path

srcs = glob.glob('/opt/homebrew/Cellar/openssl@3/*/include/openssl')
if not srcs:
  raise SystemExit('OpenSSL headers not found under /opt/homebrew/Cellar/openssl@3')
src = sorted(srcs)[-1]

dst = Path('openssl/include/openssl')
dst.parent.mkdir(parents=True, exist_ok=True)
if dst.exists():
  shutil.rmtree(dst)
shutil.copytree(src, dst)
print('Vendored OpenSSL headers:', src, '->', dst)
PY
""",
        # Vendor OpenSSL libs too so the Bazel link step can find -lssl/-lcrypto
        # without relying on host linker search paths.
        """python3 - <<'PY'
from __future__ import annotations

import glob
import shutil
from pathlib import Path

lib_candidates = glob.glob('/opt/homebrew/Cellar/openssl@3/*/lib/libssl*')
if not lib_candidates:
  raise SystemExit('OpenSSL libs not found under /opt/homebrew/Cellar/openssl@3')

root = sorted(glob.glob('/opt/homebrew/Cellar/openssl@3/*'))[-1]
src_lib_dir = Path(root) / 'lib'

dst = Path('openssl/lib')
if dst.exists():
  shutil.rmtree(dst)
dst.mkdir(parents=True, exist_ok=True)

for name in ['libssl.a', 'libcrypto.a']:
  src = src_lib_dir / name
  if not src.exists():
    raise SystemExit(f'OpenSSL static lib not found: {src}')
  shutil.copy2(src, dst / src.name)

print('Vendored OpenSSL libs into:', dst)
PY
""",
    ],
    sha256 = "d3a60676b1df3fb9850f6ce1e8a3df9a0efac036ceb4bce8ce46ee3eca735d2d",
    strip_prefix = "thrift-0.24.0",
    urls = [
        "https://github.com/apache/thrift/archive/refs/tags/v0.24.0.tar.gz",
    ],
)

# Fully-static musl Linux toolchain for BusyBox / scratch container images.
# Gated behind //platforms:musl_static so host builds are unaffected.
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1")

toolchains_musl = use_extension(
    "@toolchains_musl//:toolchains_musl.bzl",
    "toolchains_musl",
)
toolchains_musl.config(
    extra_target_compatible_with = ["//platforms:musl_static"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")

register_toolchains("@musl_toolchains_hub//:all")

# Hermetic zig-cc for cross-compiling to Intel/ARM Linux (and optional
# Darwin/Windows). Toolchains are NOT registered globally — configs pull
# them in via --extra_toolchains so Apple/host clang stays default.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(zig, "zig_sdk")


# Client-library packaging rulesets land in M6 (docs/development-plan.md).
# M5-T02 only adds Thrift stub *codegen* (`//clients/*/thrift_stubs`); language
# rulesets stay commented so `bazel build //aster/...` remains lean:
#   bazel_dep(name = "rules_python", ...)       # //clients/python wheel
#   bazel_dep(name = "rules_go", ...)           # //clients/go
#   bazel_dep(name = "rules_rust", ...)         # //clients/rust crate
#   bazel_dep(name = "rules_jvm_external", ...) # //clients/java + //clients/scala
#   bazel_dep(name = "rules_scala", ...)
#   bazel_dep(name = "aspect_rules_js", ...)    # //clients/javascript npm package
