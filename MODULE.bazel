"""Aster: a peer-to-peer, low-resource vector database.

Monorepo layout:
  //aster/...    C++ core engine (kernel, storage, index, distributed, query, rpc)
  //clients/...  Client libraries (C++, Python, Go, Rust, Java, Scala, JavaScript)
  //tla/...      TLA+ formal specifications
  //docs/...     Design and reference documentation
"""

module(
    name = "aster",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "lz4", version = "1.10.0.bcr.1")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

# Fully-static musl Linux toolchain for BusyBox / scratch container images.
# Gated behind //platforms:musl_static so host builds are unaffected.
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1")

toolchains_musl = use_extension(
    "@toolchains_musl//:toolchains_musl.bzl",
    "toolchains_musl",
)
toolchains_musl.config(
    extra_target_compatible_with = ["//platforms:musl_static"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")

register_toolchains("@musl_toolchains_hub//:all")

# Hermetic zig-cc for cross-compiling to Intel/ARM Linux (and optional
# Darwin/Windows). Toolchains are NOT registered globally — configs pull
# them in via --extra_toolchains so Apple/host clang stays default.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

zig = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
)
use_repo(zig, "zig_sdk")


# Client-library rulesets are wired in per milestone M6 (see
# docs/development-plan.md). They are intentionally not added yet so that
# `bazel build //...` stays fast and hermetic while the core engine is the
# focus:
#   bazel_dep(name = "rules_python", ...)       # //clients/python wheel
#   bazel_dep(name = "rules_go", ...)           # //clients/go
#   bazel_dep(name = "rules_rust", ...)         # //clients/rust crate
#   bazel_dep(name = "rules_jvm_external", ...) # //clients/java + //clients/scala
#   bazel_dep(name = "rules_scala", ...)
#   bazel_dep(name = "aspect_rules_js", ...)    # //clients/javascript npm package
